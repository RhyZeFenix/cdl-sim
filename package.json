{
  "name": "cdl-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Call of Duty League season simulator (CDL 2024 MWIII, 2025 BO6, 2026 BO7)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:check": "tsx scripts/data-check.ts",
    "series": "tsx scripts/sim-series.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "season": "tsx scripts/sim-season.ts",
    "parity": "tsx scripts/parity.ts",
    "backtest": "tsx scripts/backtest.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
